{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Infinihash/infinihash-kyt-mcp",
  "description": "Blockchain compliance: screen wallets vs OFAC SDN + threat intel, open cases, generate SAR drafts",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/Infinihash/infinihash-kyt-mcp",
    "source": "github"
  },
  "websiteUrl": "https://kyt.infinihash.com",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "infinihash-kyt-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KYT_API_KEY",
          "description": "Free key at https://kyt.infinihash.com/kyt/settings/api-keys",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "KYT_BASE_URL",
          "description": "Override only for self-hosted/staging",
          "default": "https://kyt.infinihash.com/api/v1",
          "isRequired": false
        }
      ]
    }
  ]
}